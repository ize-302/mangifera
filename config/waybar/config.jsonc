{
	// Glyphs are written as \u escapes so editors can't mangle Nerd Font codepoints.
	"layer": "top",
	"position": "bottom",
	"height": 32,
	"spacing": 0,
	"modules-left": [
		"custom/tag#1",
		"custom/tag#2",
		"custom/tag#3",
		"custom/tag#4",
		"custom/tag#5",
		"custom/tag#6",
		"custom/tag#7",
		"custom/tag#8",
		"custom/tag#9",
		"custom/scratchpad",
		"custom/mode"
	],
	"modules-center": [
		"temperature",
		"disk",
		"cpu",
		"memory",
		"battery"
	],
	"modules-right": [
		"custom/recording",
		"tray",
		"custom/volume",
		"backlight",
		"custom/pomodoro",
		"network",
		"bluetooth",
		"custom/notifications",
		"custom/clock"
	],

	// Tags, scratchpad and mode are written by ~/.local/bin/bar-tags (SIGRTMIN+13)
	"custom/tag#1": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-1.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,1,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#2": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-2.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,2,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#3": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-3.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,3,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#4": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-4.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,4,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#5": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-5.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,5,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#6": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-6.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,6,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#7": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-7.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,7,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#8": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-8.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,8,$(mmsg get cursorpos | jq -r .monitor)"
	},
	"custom/tag#9": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/$WAYBAR_OUTPUT_NAME-9.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "mmsg dispatch viewcrossmon,9,$(mmsg get cursorpos | jq -r .monitor)"
	},

	"custom/scratchpad": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/scratchpad.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13,
		"on-click": "~/.local/bin/scratchpad-menu"
	},

	"custom/mode": {
		"exec": "cat \"$XDG_RUNTIME_DIR/bar-tags/mode.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 13
	},

	// No `states` for temperature, so the icon carries the colour (index = temp / 5)
	"temperature": {
		"thermal-zone": 0,
		"critical-threshold": 100,
		"interval": 1,
		"format": "{icon} {temperatureC}ºC</span>",
		"format-icons": [
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#bfff00'>",
			"<span color='#ffff00'>",
			"<span color='#ffbf00'>",
			"<span color='#ff8000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>"
		],
		"tooltip": false
	},

	"disk": {
		"path": "/",
		"interval": 30,
		"unit": "GiB",
		"format": " {percentage_used}%",
		"states": { "d0": 0, "d50": 50, "d65": 65, "d75": 75, "d85": 85, "d92": 92 },
		"tooltip-format": "Used {specific_used:0.0f}G\nFree {specific_free:0.0f}G\nTotal {specific_total:0.0f}G"
	},

	// State classes are coloured in style.css
	"cpu": {
		"interval": 1,
		"format": " {usage}%",
		"states": { "c0": 0, "c10": 10, "c25": 25, "c50": 50, "c60": 60, "c70": 70 },
		"on-click": "~/.local/bin/btop-toggle",
		"tooltip": false
	},

	"memory": {
		"interval": 1,
		"format": " {percentage}%",
		"states": { "c0": 0, "c10": 10, "c25": 25, "c50": 50, "c60": 60, "c70": 70 },
		"on-click": "~/.local/bin/btop-toggle",
		"tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nFree {avail:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
	},

	// States match when capacity <= value
	"battery": {
		"interval": 1,
		"states": { "lt10": 9, "lt30": 29, "lt50": 49, "lt80": 79, "lt100": 99 },
		"format": "{icon} {capacity}%",
		"format-time": "{H}h{M}m",
		"format-icons": {
			"charging": "󰂄",
			"plugged": "󰂄",
			"full": "󰂄",
			"not charging": "󰂄",
			"lt10": "󰁻",
			"lt30": "󰁼",
			"lt50": "󰁾",
			"lt80": "󰂀",
			"default": "󰁹"
		},
		"tooltip-format": "{timeTo}",
		"tooltip-format-discharging": "{time} left",
		"tooltip-format-charging": "{time} until full"
	},

	"backlight": {
		"format": "󰖨 {percent}%",
		"tooltip": false
	},

	// Written by Quickshell (BarVolume.qml, SIGRTMIN+10)
	"custom/volume": {
		"exec": "cat \"$XDG_RUNTIME_DIR/volume.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 10,
		"tooltip": false,
		"on-click": "~/.local/bin/control-panel --pointer",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
	},

	// Signalled by ~/.local/bin/record-toggle (SIGRTMIN+12)
	"custom/recording": {
		"exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\": \"\\udb81\\udc4a\", \"tooltip\": \"Recording the screen. Click to stop\"}' || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 12,
		"on-click": "~/.local/bin/record-toggle"
	},

	// Written by Quickshell (Pomodoro.qml, SIGRTMIN+11)
	"custom/pomodoro": {
		"exec": "cat \"$XDG_RUNTIME_DIR/pomodoro.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 11,
		"on-click": "~/.local/bin/launcher-call pomodoro toggle",
		"on-click-right": "~/.local/bin/launcher-call pomodoro reset",
		"on-click-middle": "~/.local/bin/launcher-call pomodoro skip"
	},

	// Written by Quickshell (Notifications.qml, SIGRTMIN+8)
	"custom/notifications": {
		"exec": "cat \"$XDG_RUNTIME_DIR/notifications.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"tooltip": false,
		"on-click": "~/.local/bin/notification-center --pointer",
		"on-click-right": "~/.local/bin/launcher-call notifications toggleDoNotDisturb"
	},

	"custom/clock": {
		"exec": "~/.local/bin/clock-status",
		"return-type": "json",
		"justify": "left",
		"interval": 10,
		"on-click": "~/.local/bin/date-panel --pointer"
	},

	"network": {
		"interval": 2,
		"format-wifi": "{icon}",
		"format-icons": ["\udb82\udcbf", "\udb82\udcbc", "\udb82\udcbd", "\udb82\udcbe"],
		"format-ethernet": "\udb80\ude00",
		"format-linked": "\udb81\udf83",
		"format-disconnected": "\udb81\udf83",
		"format-disabled": "\udb81\udf83",
		"tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
		"tooltip-format-ethernet": "Ethernet\n{ipaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
		"tooltip-format-disconnected": "Not connected",
		"tooltip-format-disabled": "Wi-Fi off",
		"on-click": "~/.local/bin/control-panel --pointer Network"
	},

	"bluetooth": {
		"format": "󰂯",
		"format-connected": "󰂱",
		"format-off": "󰂲",
		"format-disabled": "󰂲",
		"format-no-controller": "",
		"tooltip-format": "{controller_alias}: on, no devices connected",
		"tooltip-format-off": "Bluetooth off",
		"tooltip-format-disabled": "Bluetooth disabled",
		"tooltip-format-connected": "{controller_alias}: {num_connections} connected\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
		"on-click": "~/.local/bin/control-panel --pointer Bluetooth",
		"on-click-right": "blueman-manager"
	},

	"tray": {
		"icon-size": 21,
		"spacing": 14
	}
}
