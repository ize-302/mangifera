# Machine-specific mango settings
config/mango/local.conf
# Generated by Quickshell
config/quickshell/*/.qmlls.ini
# Built by install.sh from src/bluetooth-agent/bluetooth-agent.c
home/.local/bin/bluetooth-agent
# Built by install.sh from src/network-info
home/.local/bin/network-info
# Built by install.sh from src/launcher; app-menu and the rest link to it
home/.local/bin/launcher-call
# Built by install.sh from src/btop-toggle
home/.local/bin/btop-toggle
# Built by install.sh from src/screenshot
home/.local/bin/screenshot
# Built by install.sh from src/wallpaper
home/.local/bin/wallpaper
# Built by install.sh from src/record; record-status and cam-toggle link to it
home/.local/bin/record-toggle
# Built by install.sh from src/window; move-window and focus-urgent link to it
home/.local/bin/focus-window
# Built by install.sh from src/display; laptop-screen links to it
home/.local/bin/primary-output
# Built by install.sh from src/clock-status
home/.local/bin/clock-status
# Built by install.sh from src/bluetooth-audio
home/.local/bin/bluetooth-audio
# Built by install.sh from src/gtk-radius
home/.local/bin/gtk-radius
# Built by install.sh from src/bar-anchor and src/bar-watchdog
home/.local/bin/bar-anchor
home/.local/bin/bar-watchdog
# Built by install.sh from src/mango-reload
home/.local/bin/mango-reload
