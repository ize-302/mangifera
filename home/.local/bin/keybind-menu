#!/bin/bash
# Toggles the Quickshell key bindings menu, starting its daemon if needed.
toggle=(qs -c launcher ipc call keybinds toggleKeybindMenu)

"${toggle[@]}" >/dev/null 2>&1 && exit 0

if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
