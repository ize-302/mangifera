#!/bin/bash
# Writes ~/.config/gtk-3.0/radius.css: adw-gtk3's radii capped at 4px.
# Rerun after an adw-gtk-theme update. Every radius rule is copied, 0s too,
# since gtk.css outranks the theme regardless of selector.
theme=/usr/share/themes/adw-gtk3-dark/gtk-3.0/gtk.css
out=~/.config/gtk-3.0/radius.css

[ -r "$theme" ] || { echo "No $theme (adw-gtk-theme)" >&2; exit 1; }

# Radii at or above pill stay (circles, pills)
awk -v radius=4 -v pill=99 -v theme="$theme" -v out="$out" '
{ css = css $0 "\n" }

function shrink(value,    done, px) {
	done = ""
	while (match(value, /[0-9]+(\.[0-9]+)?px/)) {
		px = substr(value, RSTART, RLENGTH - 2) + 0
		done = done substr(value, 1, RSTART - 1) (px > radius && px < pill ? radius "px" : substr(value, RSTART, RLENGTH))
		value = substr(value, RSTART + RLENGTH)
	}
	return done value
}

function trim(s) {
	gsub(/^[ \t\n\r\f]+|[ \t\n\r\f]+$/, "", s)
	return s
}

END {
	# Strip comments
	plain = ""
	while ((start = index(css, "/*")) > 0) {
		plain = plain substr(css, 1, start - 1)
		css = substr(css, start + 2)
		end = index(css, "*/")
		css = end ? substr(css, end + 2) : ""
	}
	css = plain css

	# Innermost "selector { body }" rules
	count = 0
	rules = ""
	n = split(css, chunks, "}")
	for (i = 1; i < n; i++) {
		chunk = chunks[i]
		if ((brace = match(chunk, /\{[^{]*$/)) == 0)
			continue
		body = substr(chunk, brace + 1)
		head = substr(chunk, 1, brace - 1)
		sub(/.*\{/, "", head)
		if (head == "")
			continue

		lines = ""
		while (match(body, /border(-[a-z]+)?-radius[ \t\n\r\f]*:[ \t\n\r\f]*[^;]+;/)) {
			decl = substr(body, RSTART, RLENGTH - 1)
			body = substr(body, RSTART + RLENGTH)
			name = decl
			sub(/[ \t\n\r\f]*:.*/, "", name)
			value = decl
			sub(/^[^:]*:/, "", value)
			lines = lines "  " name ": " shrink(trim(value)) ";\n"
		}
		if (lines == "")
			continue

		gsub(/[ \t\n\r\f]+/, " ", head)
		rules = rules (count++ ? "\n" : "") trim(head) " {\n" lines "}\n"
	}
	printf "/* Generated by ~/.local/bin/gtk-radius from %s */\n\n%s", theme, rules
	print count " rules written to " out > "/dev/stderr"
}
' "$theme" >"$out.tmp" && mv -f "$out.tmp" "$out"
