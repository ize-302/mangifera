#!/bin/bash
# control-panel [--pointer] [section]
# Toggles the Quickshell sound popup, or opens a section ("Network", "Bluetooth").
# --pointer centres it over the bar module under the pointer.
at=""
if [ "$1" = "--pointer" ]; then
	at="AtPointer"
	shift
fi
if [ -n "$1" ]; then
	toggle=(controlPanel "openSection$at" "$1")
else
	toggle=(controlPanel "toggleControlPanel$at")
fi

exec ~/.local/bin/launcher-call "${toggle[@]}"
