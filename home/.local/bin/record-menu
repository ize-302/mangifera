#!/bin/bash
# Toggles the Quickshell menu that sets up a screen recording, starting its
# daemon if needed. While recording it opens it to change the running one
# (sound, camera) or stop it.
toggle=(record toggleRecordMenu)
if pgrep -x wf-recorder >/dev/null; then
	toggle=(record toggleLiveMenu)
fi

exec ~/.local/bin/launcher-call "${toggle[@]}"
