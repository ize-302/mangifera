#!/bin/bash
# Restarts waybar when it uses over half a core for a whole minute. Twice it
# had threads spinning at 100% each for hours, cause unknown; this caps that
# at a minute. Each restart is logged (journalctl -t bar-watchdog) and
# notified, to help find the cause.
period=60
limit=$((period * $(getconf CLK_TCK) / 2))

# CPU ticks used so far by a process
ticks() {
	awk '{print $14 + $15}' "/proc/$1/stat" 2>/dev/null
}

while :; do
	pid=$(pgrep -ox waybar)
	before=$(ticks "$pid")
	sleep "$period"
	after=$(ticks "$pid")
	# Restarted, or not running
	[ -z "$before" ] || [ -z "$after" ] || [ "$pid" != "$(pgrep -ox waybar)" ] && continue

	used=$((after - before))
	if [ "$used" -gt "$limit" ]; then
		hot=$(top -b -n 1 -H -p "$pid" | awk '$9 > 50 {printf "%s(%s%%) ", $1, $9}')
		logger -t bar-watchdog "waybar $pid used $((used * 100 / period / $(getconf CLK_TCK)))% CPU for ${period}s, threads: $hot; restarting"
		notify-send -a waybar -u low "Bar restarted" "It was using too much CPU."
		kill "$pid"
		sleep 1
		setsid -f waybar >/dev/null 2>&1
	fi
done
