#!/bin/bash
# Writes waybar's tag, scratchpad and mode modules as JSON files in
# $XDG_RUNTIME_DIR/bar-tags/ on every mango change, then signals waybar
# (SIGRTMIN+13).
dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/bar-tags
mkdir -p "$dir"

read -r -d '' program <<'EOF'
# Thin spaces (U+2009) around each icon
def icon:
	(.appid // "") as $id |
	[
		["^Alacritty$", ""],
		["^btop$", ""],
		["^(zen.*|firefox.*|librewolf)$", ""],
		["^(google-chrome.*|chromium.*)$", ""],
		["^[Tt]hunar$", ""],
		["^com\\.obsproject\\.Studio$", ""],
		["^(mpv|vlc)$", ""],
		["^blueman-manager$", ""],
		["^nm-connection-editor$", ""]
	] | (map(select(. as [$re] | $id | test($re))) | first | .[1]) // "" |
	"  " + . + " ";

($clients.clients // []) as $clients |
($monitors.monitors // []) as $monitors |
($clients | map(select(.is_minimized and (.is_namedscratchpad | not)))) as $parked |
([$monitors[] | select(.active)][0].keymode // "default") as $mode |
(
	[
		$monitors[] as $m | $m.tags[] as $t |
		($clients | map(select(.monitor == $m.name and (.is_minimized | not) and (.tags | index($t.index)))) | sort_by(.id)) as $windows |
		{
			key: "\($m.name)-\($t.index).json",
			value: (if $t.is_active or ($windows | length) > 0 then {
				text: "\($t.index)" + ($windows | map(icon) | join("")),
				tooltip: false,
				class: [
					(if $t.is_active and $m.active then "focused" elif $t.is_active then "visible" else empty end),
					(if $t.is_urgent then "urgent" else empty end),
					(if ($windows | length) == 0 then "empty" else empty end)
				]
			} else {text: ""} end)
		}
	]
	+ [{
		key: "scratchpad.json",
		value: (if ($parked | length) == 0 then {text: ""} else {
			text: (["•", "••", "•••", "••••", "••••+"][([$parked | length, 5] | min) - 1]),
			tooltip: ($parked | map("\(.appid): \(.title)") | join("\n"))
		} end)
	}]
	+ [{
		key: "mode.json",
		value: (if $mode == "default" then {text: ""} else {text: $mode, tooltip: false} end)
	}]
) | from_entries
EOF

last=
render() {
	local state
	state=$(jq -n -c --argjson clients "$(mmsg get all-clients)" --argjson monitors "$(mmsg get all-monitors)" "$program") || return
	[ "$state" = "$last" ] && return
	last=$state
	jq -r 'to_entries[] | "\(.key)\t\(.value | tojson)"' <<<"$state" |
		while IFS=$'\t' read -r file json; do
			echo "$json" >"$dir/$file"
		done
	signal_bar
}

# A signal kills waybar before its handlers are set up, so wait for young ones
signal_bar() {
	pkill -RTMIN+13 -x -O 1 waybar
	if pgrep -x waybar >/dev/null && ! pgrep -x -O 1 waybar >/dev/null; then
		(sleep 1.5 && pkill -RTMIN+13 -x -O 1 waybar) &
	fi
}

render
# Drain event bursts before rendering
{
	mmsg watch all-clients &
	mmsg watch all-monitors &
	wait -n
	kill $(jobs -p) 2>/dev/null
} | while read -r _; do
	while read -r -t 0.03 _; do :; done
	render
done
