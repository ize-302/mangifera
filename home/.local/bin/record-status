#!/bin/bash
# The bar's recording indicator, run by waybar for as long as the bar is up.
# While wf-recorder (~/.local/bin/record-toggle) runs it prints the dot and
# how long it has been going each second, as waybar JSON; otherwise one empty
# line, then it sleeps until record-toggle wakes it (SIGUSR1) instead of
# checking every second.

# Dies with waybar instead of sleeping on forever
if [ -z "$RECORD_STATUS_CHILD" ]; then
	RECORD_STATUS_CHILD=1 exec setpriv --pdeathsig TERM "$0"
fi

# One per bar (waybar runs one for each screen); record-toggle signals them all
dir=${XDG_RUNTIME_DIR:-/tmp}/record-status
mkdir -p "$dir"
for file in "$dir"/*; do
	[ -e "$file" ] && ! kill -0 "${file##*/}" 2>/dev/null && rm -f "$file"
done
touch "$dir/$$"

sleeper=
trap 'kill $sleeper 2>/dev/null; rm -f "$dir/$$"' EXIT
trap 'exit' TERM HUP PIPE
# Only cuts the sleep short
trap ':' USR1

while :; do
	if pid=$(pgrep -ox wf-recorder); then
		secs=$(ps -o etimes= -p "$pid")
		secs=${secs// /}
		if [ "$secs" -ge 3600 ]; then
			elapsed=$(printf '%d:%02d:%02d' $((secs / 3600)) $((secs % 3600 / 60)) $((secs % 60)))
		else
			elapsed=$(printf '%02d:%02d' $((secs / 60)) $((secs % 60)))
		fi
		# The dot pulses (style.css); the time keeps its own colour so it
		# stays put
		printf '{"text": "\\udb81\\udc4a <span color=\\"#ffffff\\" font_features=\\"tnum\\">%s</span>", "tooltip": "Recording the screen. Click to stop", "class": "recording"}\n' "$elapsed"
		sleep 1 &
	else
		echo '{"text": ""}'
		sleep infinity &
	fi
	sleeper=$!
	wait "$sleeper"
	kill "$sleeper" 2>/dev/null
done
