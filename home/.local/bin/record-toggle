#!/bin/bash
# record-toggle [--none|--desktop|--mic|--both] [--camera] [--fps=N]
# record-toggle --live-sound=<none|desktop|mic|both>
# Starts recording a slurp-picked area to ~/Videos/Recordings, or stops the
# running one. --desktop adds the playing audio, --mic (or --sound) the
# default mic, --both the two mixed. --camera shows the webcam bubble
# (CameraWidget.qml) from picking the area until the recording stops. --fps
# sets a constant frame rate, 60 by default; 0 leaves it uncapped. With no
# option it only stops. --live-sound changes the running recording's sound
# (from the record menu, RecordMenu.qml), without stopping it.
dir=~/Videos/Recordings

camera=
fps=60
live_sound=
args=()
for arg in "$@"; do
	case "$arg" in
	--camera)
		camera=1
		;;
	--fps=*)
		fps="${arg#--fps=}"
		;;
	--live-sound=*)
		live_sound="${arg#--live-sound=}"
		;;
	*)
		args+=("$arg")
		;;
	esac
done
set -- "${args[@]}"

# Shows or hides the webcam bubble, if recording with it
cam() {
	[ -n "$camera" ] && ~/.local/bin/launcher-call camera "$1"
}

# Shows or hides the bar's recording timer (Bar.qml)
bar() {
	~/.local/bin/launcher-call bar recordingChanged
}

# Every recording takes its sound from a sink of its own, record_mix, with
# the mic and the playing audio looped into it as picked. wf-recorder takes
# one source, fixed when it starts, so this way the sound can change while
# recording. With no sound it records the sink's silence.

# Ids of the loaded modules feeding (or being) record_mix, matched by their
# arguments, so any run finds the ones the starting run loaded
mix_modules() {
	pactl list modules short | awk -v kind="$1" '$2 == kind && /record_mix/ { print $1 }'
}

# Feeds record_mix the given sound: none, desktop, mic or both
mix() {
	local m default_sink
	for m in $(mix_modules module-loopback); do
		pactl unload-module "$m"
	done
	default_sink="$(pactl get-default-sink)"
	case "$1" in
	mic | both)
		pactl load-module module-loopback source=@DEFAULT_SOURCE@ sink=record_mix latency_msec=20 >/dev/null
		;;
	esac
	case "$1" in
	desktop | both)
		pactl load-module module-loopback source="${default_sink}.monitor" sink=record_mix latency_msec=20 >/dev/null
		;;
	esac
}

unload() {
	local m
	for m in $(mix_modules module-loopback) $(mix_modules module-null-sink); do
		pactl unload-module "$m"
	done
}

if [ -n "$live_sound" ]; then
	pgrep -x wf-recorder >/dev/null && mix "$live_sound"
elif pgrep -x wf-recorder >/dev/null; then
	# The starting run handles the rest
	pkill -INT wf-recorder
elif [ $# -gt 0 ]; then
	case "$1" in
	-m | --mic | -s | --sound) sound=mic ;;
	-d | --desktop) sound=desktop ;;
	-b | --both) sound=both ;;
	*) sound=none ;;
	esac
	# Left over from a run that didn't get to clean up
	unload
	trap unload EXIT
	pactl load-module module-null-sink sink_name=record_mix sink_properties=device.description=Recording >/dev/null
	mix "$sound"
	audio_args=(--audio=record_mix.monitor)

	# Shown while picking, so it can be placed in the area first
	cam show
	notify-send "Select area to record" "Drag an area, or click a screen for all of it"
	if ! area=$(slurp -o); then
		cam hide
		exit 0
	fi

	# 3-2-1 over the area (RecordCountdown.qml), gone before recording starts.
	# Escape there sends SIGUSR1, which cuts the wait short
	cancelled=
	trap 'cancelled=1' USR1
	~/.local/bin/launcher-call record countdown "$$ $area"
	sleep 3.2 &
	wait $!
	if [ -n "$cancelled" ]; then
		kill $! 2>/dev/null
		cam hide
		exit 0
	fi
	mkdir -p "$dir"
	file="$dir/rec-$(date +%Y%m%d-%H%M%S).mp4"
	# Encode on the GPU: libx264rgb only managed ~33 fps of a moving screen,
	# and starving the CPU lost audio, so the sound drifted ahead of the
	# picture. It also makes plain 4:2:0 H.264 that any player decodes
	codec_args=(-c libx264rgb)
	if [ -e /dev/dri/renderD128 ]; then
		# The GPU writes video range (16-235) whatever wf-recorder asks for,
		# which it then labels full range, so players showed it washed out.
		# Label it as what it is
		codec_args=(-c h264_vaapi -d /dev/dri/renderD128 -p color_range=tv)
	fi
	# Left alone it writes a frame per screen update, up to the refresh rate,
	# and sites such as X refuse anything over 60 fps
	fps_args=()
	if [ "$fps" -gt 0 ] 2>/dev/null; then
		fps_args=(-r "$fps")
	fi
	wf-recorder -g "$area" "${fps_args[@]}" "${codec_args[@]}" "${audio_args[@]}" -f "$file" &
	sleep 0.3
	bar
	wait
	unload
	# Whether or not it started with the camera: the menu can turn it on
	# while recording
	~/.local/bin/launcher-call camera hide
	bar

	if [ ! -s "$file" ]; then
		notify-send -u critical "Recording failed" "Nothing was recorded."
		exit 1
	fi

	thumb="${XDG_RUNTIME_DIR:-/tmp}/record-toggle-${file##*/}.png"
	ffmpegthumbnailer -i "$file" -o "$thumb" -s 256 2>/dev/null || thumb=video-x-generic

	action=$(timeout 1h notify-send -a "Screen recording" -i "$thumb" \
		--action=default=Play --action=folder="Show in folder" --wait \
		"Recording saved" "${file##*/}")
	case "$action" in
	default)
		xdg-open "$file"
		;;
	folder)
		gdbus call --session --dest org.freedesktop.FileManager1 \
			--object-path /org/freedesktop/FileManager1 \
			--method org.freedesktop.FileManager1.ShowItems "['file://$file']" "" >/dev/null
		;;
	esac
fi
