#!/bin/bash
# record-toggle [--none|--desktop|--mic|--both]
# Starts recording a slurp-picked area to ~/Videos/Recordings, or stops the
# running one. --desktop adds the playing audio, --mic (or --sound) the
# default mic, --both the two mixed. With no option it only stops.
dir=~/Videos/Recordings

# Wakes the bar's ~/.local/bin/record-status, one per bar
bar() {
	local file
	for file in "${XDG_RUNTIME_DIR:-/tmp}"/record-status/*; do
		[ -e "$file" ] && kill -USR1 "${file##*/}" 2>/dev/null
	done
}

# Audio modules loaded for --both
modules=()
unload() {
	for m in "${modules[@]}"; do
		pactl unload-module "$m"
	done
	modules=()
}

if pgrep -x wf-recorder >/dev/null; then
	# The starting run handles the rest
	pkill -INT wf-recorder
elif [ $# -gt 0 ]; then
	audio_args=()
	case "$1" in
	-m | --mic | -s | --sound)
		audio_args=(--audio)
		;;
	-d | --desktop)
		default_sink="$(pactl get-default-sink)"
		audio_args=(--audio="${default_sink}.monitor")
		;;
	-b | --both)
		# wf-recorder takes one source, so mix the mic and the playing audio
		# into a sink of their own while recording
		default_sink="$(pactl get-default-sink)"
		trap unload EXIT
		modules+=("$(pactl load-module module-null-sink sink_name=record_mix sink_properties=device.description=Recording)")
		modules+=("$(pactl load-module module-loopback source=@DEFAULT_SOURCE@ sink=record_mix latency_msec=20)")
		modules+=("$(pactl load-module module-loopback source="${default_sink}.monitor" sink=record_mix latency_msec=20)")
		audio_args=(--audio=record_mix.monitor)
		;;
	esac

	notify-send "Select area to record"
	area=$(slurp -o) || exit 0
	mkdir -p "$dir"
	file="$dir/rec-$(date +%Y%m%d-%H%M%S).mp4"
	# Encode on the GPU: libx264rgb only managed ~33 fps of a moving screen,
	# and starving the CPU lost audio, so the sound drifted ahead of the
	# picture. It also makes plain 4:2:0 H.264 that any player decodes
	codec_args=(-c libx264rgb)
	if [ -e /dev/dri/renderD128 ]; then
		# The GPU writes video range (16-235) whatever wf-recorder asks for,
		# which it then labels full range, so players showed it washed out.
		# Label it as what it is
		codec_args=(-c h264_vaapi -d /dev/dri/renderD128 -p color_range=tv)
	fi
	wf-recorder -g "$area" "${codec_args[@]}" "${audio_args[@]}" -f "$file" &
	sleep 0.3
	bar
	wait
	unload
	bar

	if [ ! -s "$file" ]; then
		notify-send -u critical "Recording failed" "Nothing was recorded."
		exit 1
	fi

	thumb="${XDG_RUNTIME_DIR:-/tmp}/record-toggle-${file##*/}.png"
	ffmpegthumbnailer -i "$file" -o "$thumb" -s 256 2>/dev/null || thumb=video-x-generic

	action=$(timeout 1h notify-send -a "Screen recording" -i "$thumb" \
		--action=default=Play --action=folder="Show in folder" --wait \
		"Recording saved" "${file##*/}")
	case "$action" in
	default)
		xdg-open "$file"
		;;
	folder)
		gdbus call --session --dest org.freedesktop.FileManager1 \
			--object-path /org/freedesktop/FileManager1 \
			--method org.freedesktop.FileManager1.ShowItems "['file://$file']" "" >/dev/null
		;;
	esac
fi
