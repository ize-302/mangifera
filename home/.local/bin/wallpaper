#!/bin/bash
# wallpaper [--random|--follow|FILE]
# Sets the wallpaper with awww (no argument: the last one). Saves its path
# and a small copy for the lock screen, and copies it to
# /var/lib/sddm-wallpaper for SDDM. --follow keeps setting it again on each
# display that turns on.
dir=~/Pictures/wallpapers
default=~/.local/share/mangifera/default-wallpaper.jpg
share=/var/lib/sddm-wallpaper
state=${XDG_STATE_HOME:-$HOME/.local/state}/mangifera/wallpaper
lock=${state%/*}/lock-wallpaper.jpg

current=$(cat -- "$state" 2>/dev/null)

# The daemon runs with --no-cache, so it leaves a display that turns on (one
# plugged in, or the laptop's after an unplug) black
if [ "$1" = --follow ]; then
	# mango lists a display even while it's off, so ask wlr-randr
	names() {
		wlr-randr --json | jq -r '.[] | select(.enabled) | .name' | sort
	}

	# awww sees a display a moment after mango does
	shown() {
		local outputs name
		outputs=$(awww query 2>/dev/null) || return
		while read -r name; do
			grep -qF ": $name:" <<<"$outputs" || return
		done <<<"$1"
	}

	known=$(names)
	# Only as a signal: an event follows a display turning on or off
	mmsg watch all-monitors | while read -r _; do
		now=$(names)
		added=$(comm -13 <(echo "$known") <(echo "$now"))
		known=$now
		[ -n "$added" ] || continue
		for _ in $(seq 50); do
			shown "$added" && break
			sleep 0.1
		done
		"$0"
	done
	exit
fi

pick() {
	find -L "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null |
		grep -vxF -- "$current" | shuf -n1
}

case $1 in
--random)
	img=$(pick)
	[ -n "$img" ] || img=$current
	;;
"")
	img=$current
	[ -f "$img" ] || img=$(pick)
	;;
*)
	img=$(realpath -- "$1") || exit
	;;
esac
[ -f "$img" ] || img=$default

# --no-cache: this script picks the image, not awww's own last-used cache
if ! awww query >/dev/null 2>&1; then
	setsid -f awww-daemon --quiet --no-cache >/dev/null 2>&1 || exit
	for _ in $(seq 50); do
		awww query >/dev/null 2>&1 && break
		sleep 0.1
	done
fi

# Fades into a new image; the same one again (at login) shows at once
if [ "$img" != "$current" ]; then
	transition=(--transition-type fade --transition-duration 1 --transition-fps 60)
else
	transition=(--transition-type none)
fi
awww img "${transition[@]}" -- "$img" || exit
# swaybg drew the wallpaper before awww
pkill -u "$UID" -x swaybg
mkdir -p -- "${state%/*}"
echo "$img" >"$state"

# The lock screen shows it blurred at a quarter size. A full-size photo takes
# a second to decode, which the lock screen would show as a blank screen
if [ "$img" != "$current" ] || [ ! -e "$lock" ]; then
	magick -define jpeg:size=2560x1440 "$img" -auto-orient -thumbnail '1280x720^' -quality 90 "$lock.tmp.jpg" &&
		mv -f -- "$lock.tmp.jpg" "$lock"
fi

# Atomic rename, so the greeter never reads half an image
if [ -w "$share" ] && { [ "$img" != "$current" ] || [ ! -e "$share/current" ]; }; then
	cp -f -- "$img" "$share/.current.tmp" && mv -f "$share/.current.tmp" "$share/current"
fi
